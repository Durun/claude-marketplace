# ~/.durun-dashboard/.env.local に写して、使うものだけ値を入れる。変えたら pnpm start を起動し直す。
# DURUN_DASHBOARD_PORT と DURUN_DASHBOARD_DATA_DIR は、ここではなく Claude Code を起動するシェルの環境変数に設定する。

# JIRA のサイト（例: https://example.atlassian.net）
JIRA_BASE_URL=
# ブランチ名や PR タイトルから課題キーを拾うプロジェクト（カンマ区切り）
JIRA_PROJECT_KEYS=
# 課題の題名と状態を表示するときと、JIRA Issues のウィジェットを使うときに設定する
JIRA_EMAIL=
JIRA_API_TOKEN=

# Notion のページをダッシュボードで読むときに設定する。
# https://www.notion.so/profile/integrations のインテグレーションのトークンで、読みたいページをそのインテグレーションに共有しておく
NOTION_TOKEN=

# 資料を PDF と PNG に書き出す Chrome。既定は macOS と Windows の標準の場所
# CHROME_PATH=

# アプリ「コマンドプロンプト」が、screen や tmux のセッションにアタッチするコマンド。シェル（Windows では cmd.exe）で動かす。
# セッションの画面から開くと、そのセッションの作業ディレクトリで動かす。次の例は、作業ディレクトリの名前のセッションにアタッチし、無ければ作る。
# screen なら screen -xRR "$(basename "$PWD")" と書く
# TERMINAL_ATTACH_COMMAND=tmux new-session -A -s "$(basename "$PWD")"

# Claude が Google Cloud の認証を求めたときに、OK で動かすコマンドと、認証済みかを確かめるコマンド。確かめのコマンドが成功すれば、尋ねずに認証済みと返す
# GCLOUD_LOGIN_COMMAND=gcloud auth login
# GCLOUD_CHECK_COMMAND=gcloud auth print-access-token

# 文章校正で、疑問が説明の区切りで解けたかを TypeSafe の Jev に確かめさせるときに設定する。無ければ haiku で確かめて続ける
TYPESAFE_AI_API_KEY=

# アプリ「FL Connect」がスクリプトを置く、FL Studio のユーザーデータのフォルダー（FL の File settings の「User data folder」）。
# 無ければ、ドキュメントの下と、Windows では各ドライブの直下の Image-Line\FL Studio から探す
# FL_USER_DATA=D:\Image-Line\FL Studio
# FL Connect が ② の道のために起動する FL Studio。既定は C:\Program Files\Image-Line\FL Studio 2026\FL64.exe
# FL_STUDIO_PATH=
# FL Connect がダッシュボードの側で開く MIDI のポート。既定はどちらも FL Connect (B)。loopMIDI のように自分に返るポートは、入力用と出力用の 2 つを作って指す
# FL_CONNECT_MIDI_IN=
# FL_CONNECT_MIDI_OUT=
# ② の道で FL を起動するときに開く、WebView2 のデバッグのポート（既定は 9222）
# FL_CONNECT_DEBUG_PORT=
