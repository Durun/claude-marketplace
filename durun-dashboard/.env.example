# ~/.durun-dashboard/.env.local に写して、使うものだけ値を入れる。変えたら pnpm start を起動し直す。
# DURUN_DASHBOARD_PORT と DURUN_DASHBOARD_DATA_DIR は、ここではなく Claude Code を起動するシェルの環境変数に設定する。

# JIRA のサイト（例: https://example.atlassian.net）
JIRA_BASE_URL=
# ブランチ名や PR タイトルから課題キーを拾うプロジェクト（カンマ区切り）
JIRA_PROJECT_KEYS=
# 課題の題名と状態を表示するときと、JIRA Issues のウィジェットを使うときに設定する
JIRA_EMAIL=
JIRA_API_TOKEN=

# Notion のページをダッシュボードで読むときに設定する。
# https://www.notion.so/profile/integrations のインテグレーションのトークンで、読みたいページをそのインテグレーションに共有しておく
NOTION_TOKEN=

# Internet Explorer の Google の検索結果を、Google の Custom Search JSON API から取るときに設定する。無ければ Bing の結果を出す。
# https://developers.google.com/custom-search/v1/overview の API キーと、https://programmablesearchengine.google.com/ で「ウェブ全体を検索」にした検索エンジンの ID
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# 資料を PDF と PNG に書き出す Chrome。既定は macOS と Windows の標準の場所
# CHROME_PATH=
