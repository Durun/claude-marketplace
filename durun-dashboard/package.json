{
  "name": "durun-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild client/main.tsx --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "start": "node server/start.ts",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "install-statusline": "node server/setup.ts install",
    "uninstall-statusline": "node server/setup.ts uninstall"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
