{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -X POST -H 'content-type: application/json' -H \"X-Claude-Pid: $PPID\" --data-binary @- \"http://127.0.0.1:${DURUN_DASHBOARD_PORT:-7337}/api/hook\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -X POST -H 'content-type: application/json' -H \"X-Claude-Pid: $PPID\" --data-binary @- \"http://127.0.0.1:${DURUN_DASHBOARD_PORT:-7337}/api/hook\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -X POST -H 'content-type: application/json' -H \"X-Claude-Pid: $PPID\" --data-binary @- \"http://127.0.0.1:${DURUN_DASHBOARD_PORT:-7337}/api/hook\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -X POST -H 'content-type: application/json' -H \"X-Claude-Pid: $PPID\" --data-binary @- \"http://127.0.0.1:${DURUN_DASHBOARD_PORT:-7337}/api/hook\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -X POST -H 'content-type: application/json' -H \"X-Claude-Pid: $PPID\" --data-binary @- \"http://127.0.0.1:${DURUN_DASHBOARD_PORT:-7337}/api/hook\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -X POST -H 'content-type: application/json' -H \"X-Claude-Pid: $PPID\" --data-binary @- \"http://127.0.0.1:${DURUN_DASHBOARD_PORT:-7337}/api/hook\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
